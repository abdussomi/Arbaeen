<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hadith 9: Word-by-Word Explorer</title>
    <style>
        :root {
            --bg-color: #fdfbf7;
            --card-bg: #ffffff;
            --text-main: #2c3e50;
            --text-muted: #7f8c8d;
            --primary: #27ae60;
            --accent: #e67e22;
            --border: #e2e8f0;
        }

        /* Notion Dark Mode Compatibility Helper */
        @media (prefers-color-scheme: dark) {
            :root {
                --bg-color: #191919;
                --card-bg: #202020;
                --text-main: #rgba(255, 255, 255, 0.9);
                --text-muted: #9b9b9b;
                --border: #2f2f2f;
            }
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 16px;
            display: flex;
            justify-content: center;
            direction: ltr;
        }

        .container {
            max-width: 800px;
            width: 100%;
            background: var(--card-bg);
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            border: 1px solid var(--border);
        }

        .header {
            text-align: center;
            border-bottom: 2px solid var(--border);
            padding-bottom: 12px;
            margin-bottom: 24px;
        }

        .header h1 {
            font-size: 1.5rem;
            margin: 0 0 4px 0;
            color: var(--primary);
        }

        .header p {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin: 0;
        }

        /* Interactive Arabic Workspace */
        .arabic-workspace {
            direction: rtl;
            line-height: 2.8;
            text-align: right;
            padding: 16px;
            background: rgba(39, 174, 96, 0.03);
            border-radius: 8px;
            border: 1px dashed var(--primary);
            margin-bottom: 24px;
        }

        .word-span {
            font-size: 1.85rem;
            font-family: "Traditional Arabic", "Scheherazade New", "Amiri", serif;
            font-weight: 500;
            padding: 2px 6px;
            margin: 0 2px;
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.2s ease;
            display: inline-block;
            user-select: none;
            -webkit-user-select: none;
        }

        .word-span:hover {
            background-color: rgba(39, 174, 96, 0.15);
            color: var(--primary);
        }

        .word-span.active {
            background-color: var(--primary);
            color: white !important;
        }

        /* Inspector Panel for Details */
        .inspector-panel {
            background: var(--bg-color);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 24px;
            min-height: 80px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .inspector-placeholder {
            color: var(--text-muted);
            text-align: center;
            font-style: italic;
            font-size: 0.95rem;
        }

        .data-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 0.95rem;
            border-bottom: 1px dashed var(--border);
            padding-bottom: 4px;
        }

        .data-row:last-child {
            margin-bottom: 0;
            border-bottom: none;
            padding-bottom: 0;
        }

        .data-label {
            font-weight: 600;
            color: var(--text-muted);
        }

        .data-value {
            color: var(--text-main);
            font-weight: 500;
        }

        .arabic-val {
            font-family: "Amiri", serif;
            font-size: 1.2rem;
            color: var(--accent);
        }

        /* Footer Translation Card */
        .translation-card {
            border-top: 2px solid var(--border);
            padding-top: 16px;
            margin-top: 24px;
        }

        .translation-card h3 {
            margin: 0 0 8px 0;
            font-size: 1.1rem;
            color: var(--text-main);
        }

        .translation-text {
            font-size: 1rem;
            line-height: 1.6;
            color: var(--text-main);
            font-style: italic;
            background: var(--bg-color);
            padding: 12px;
            border-left: 4px solid var(--primary);
            border-radius: 0 4px 4px 0;
        }

        .meta-info {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 8px;
            font-weight: 500;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>Hadith 9 Explorer</h1>
        <p>Tap any Arabic word below to analyze its root, tense, and exact translation</p>
    </div>

    <!-- The actual Hadith phrase text configured word-by-word -->
    <div class="arabic-workspace" id="arabicText">
        <span class="word-span" data-id="1">مَا</span>
        <span class="word-span" data-id="2">نَهَيْتُكُمْ</span>
        <span class="word-span" data-id="3">عَنْهُ</span>
        <span class="word-span" data-id="4">فَاجْتَنِبُوهُ،</span>
        <span class="word-span" data-id="5">وَمَا</span>
        <span class="word-span" data-id="6">أَمَرْتُكُمْ</span>
        <span class="word-span" data-id="7">بِهِ</span>
        <span class="word-span" data-id="8">فَأْتُوا</span>
        <span class="word-span" data-id="9">مِنْهُ</span>
        <span class="word-span" data-id="10">مَا</span>
        <span class="word-span" data-id="11">اسْتَطَعْتُمْ،</span>
        <span class="word-span" data-id="12">فَإِنَّمَا</span>
        <span class="word-span" data-id="13">أَهْلَكَ</span>
        <span class="word-span" data-id="14">الَّذِينَ</span>
        <span class="word-span" data-id="15">مِنْ</span>
        <span class="word-span" data-id="16">قَبْلِكُمْ</span>
        <span class="word-span" data-id="17">كَثْرَةُ</span>
        <span class="word-span" data-id="18">مَسَائِلِهِمْ</span>
        <span class="word-span" data-id="19">وَاخْتِلَافُهُمْ</span>
        <span class="word-span" data-id="20">عَلَىٰ</span>
        <span class="word-span" data-id="21">أَنْبِيَائِهِمْ</span>
    </div>

    <!-- Detail Box Dynamic UI -->
    <div class="inspector-panel" id="inspector">
        <div class="inspector-placeholder">Click or tap an Arabic word above to view analytical breakdowns.</div>
    </div>

    <!-- Complete Text Translation Section -->
    <div class="translation-card">
        <h3>Full English Translation</h3>
        <div class="translation-text">
            “What I have forbidden for you, avoid. What I have ordered you [to do], do as much of it as you can. For verily, it was only the excessive questioning and their disagreeing with their Prophets that destroyed [the nations] who were before you.”
        </div>
        <div class="meta-info">
            On the authority of Abu Hurayrah (ra) • Narrated by Bukhari & Muslim
        </div>
    </div>
</div>

